# fly secrets set KEY=value  —  never commit the filled-in version
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=      # any random string; passed to setWebhook
# MISTRAL_API_KEY= (unused — migrated to Gemini)
UNUSED_MISTRAL_API_KEY=
GROQ_API_KEY=                 # voice notes only
SUPABASE_URL=
SUPABASE_SERVICE_KEY=         # service_role key — bypasses RLS (A5)
CRON_SECRET=                  # any random string; guards POST /cron/tick

# --- Apple iCloud Calendar (CalDAV) ----------------------------------------
# Tasks with a planned_on become calendar events; due_on-only tasks do not.
# App-specific password: appleid.apple.com -> Sign-In and Security -> App-
# Specific Passwords. Your normal Apple ID password will NOT work.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Run `python -m capabilities.calendar` once it is set; it prints your
# calendars and you paste the one you want here.
ICLOUD_CALENDAR_URL=

# --- Gmail (read-only, Phase 1b) -------------------------------------------
# The hourly poll on /cron/tick: card bill payments and job application
# receipts/rejections. See PLAN-GMAIL.md §4 for the full setup.
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client
# ID -> Desktop app. Enable the Gmail API and add yourself as a test user.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# One OAuth client above, one line per mailbox below. Run the setup once per
# account, SIGNED IN AS THAT ACCOUNT in the browser each time:
#
#   python -m capabilities.gmail personal
#   python -m capabilities.gmail work
#
# It prints the variable to paste. The label after GMAIL_TOKEN_ is yours to
# choose and also prefixes every stored message id, so two mailboxes can never
# be confused for one another. Adding a third is one more line — no code change.
# With none of these set the poll skips entirely and nothing else changes.
GMAIL_TOKEN_PERSONAL=
# GMAIL_TOKEN_WORK=

GEMINI_API_KEY=
