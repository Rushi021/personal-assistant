{"nodes": [{"id": "claude_skills_karpathy_guidelines_skill", "label": "Karpathy Guidelines", "file_type": "document", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_karpathy_guidelines_skill_think_before_coding", "label": "Think Before Coding", "file_type": "rationale", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not assume or hide confusion. State assumptions, surface tradeoffs, and stop to name what is unclear before implementing."}, {"id": "claude_skills_karpathy_guidelines_skill_simplicity_first", "label": "Simplicity First", "file_type": "rationale", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum code that solves the problem. Nothing speculative: no extra features, single-use abstractions, or unrequested flexibility. The guidelines bias toward caution over speed."}, {"id": "claude_skills_karpathy_guidelines_skill_surgical_changes", "label": "Surgical Changes", "file_type": "rationale", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Touch only what the request requires. Match existing style, mention unrelated dead code instead of deleting it, and remove only orphans your own edit created."}, {"id": "claude_skills_karpathy_guidelines_skill_goal_driven_execution", "label": "Goal-Driven Execution", "file_type": "rationale", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn each task into a verifiable check and loop until it passes. Weak criteria such as 'make it work' force constant clarification."}, {"id": "claude_skills_karpathy_guidelines_skill_andrej_karpathy", "label": "Andrej Karpathy", "file_type": "concept", "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "source_url": "https://x.com/karpathy/status/2015883857489522876", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_karpathy_guidelines_skill", "target": "claude_skills_karpathy_guidelines_skill_think_before_coding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_karpathy_guidelines_skill", "target": "claude_skills_karpathy_guidelines_skill_simplicity_first", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_karpathy_guidelines_skill", "target": "claude_skills_karpathy_guidelines_skill_surgical_changes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_karpathy_guidelines_skill", "target": "claude_skills_karpathy_guidelines_skill_goal_driven_execution", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_karpathy_guidelines_skill", "target": "claude_skills_karpathy_guidelines_skill_andrej_karpathy", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/karpathy-guidelines/SKILL.md", "source_lo