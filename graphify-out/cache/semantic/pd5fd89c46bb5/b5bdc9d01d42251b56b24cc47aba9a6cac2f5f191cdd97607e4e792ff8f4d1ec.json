ource_ref", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g2_two_dedupe_layers", "target": "plan_gmail_applications", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g3_rules_not_model", "target": "evaluation_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g3_rules_not_model", "target": "capabilities_gmail_parse_route", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g3_rules_not_model", "target": "plan_v1_phase_1b_sketch", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g3_rules_not_model", "target": "architecture_v1_d10_a2a_rejected", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g4_rejection_wins", "target": "plan_gmail_lane_b", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g5_praise_guard", "target": "plan_gmail_lane_b", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-GMAIL.md", "source_location": null, "weight": 1.0}, {"source": "plan_gmail_g6_company_key", "target": "plan_gmail_applications", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, 