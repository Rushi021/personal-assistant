{"nodes": [{"id": "plan_v1", "label": "V1 Implementation Plan", "file_type": "document", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build order and per-step failing checks for Phase 1a. Holds the order of work; architecture holds the why."}, {"id": "core_db_local_today", "label": "local_today", "file_type": "code", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single helper for the user's notion of today. Nothing in core or capabilities should call date.today directly."}, {"id": "core_db_open_tasks", "label": "open_tasks", "file_type": "code", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The morning rollover query. Must be an index scan on tasks_open_planned_idx, not a sequential scan."}, {"id": "core_db_week_minutes_used", "label": "week_minutes_used", "file_type": "code", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sums committed minutes from Monday 00:00 local, not a trailing seven days."}, {"id": "plan_v1_a1_telegram", "label": "A1 Telegram for V1", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same channel call as D6. Reverse cost is one adapter and a fixed-shape 11am template; nothing else changes."}, {"id": "plan_v1_a2_python_stack", "label": "A2 Python FastAPI Supabase Stack", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python 3.12, FastAPI, Supabase, and an Anthropic SDK tool runner, with claude-haiku-4-5 for chat and claude-opus-5 for planning. Reversal is expensive after Step 2. This vendor list disagrees with architecture D7, which specifies Mistral."}, {"id": "plan_v1_a3_fly_day_one", "label": "A3 Deploy Fly on Day One", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosting surprises found in week three are the expensive kind."}, {"id": "plan_v1_a4_monday_reset", "label": "A4 Monday Local Reset", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This week means Monday through Sunday. One constant if that assumption is wrong."}, {"id": "plan_v1_a5_service_role", "label": "A5 service_role Bypasses RLS", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bot server uses the Supabase service_role key. That key must never reach a browser."}, {"id": "plan_v1_a6_budget_never_spoken", "label": "A6 Budget Never Spoken", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arithmetic decides when to speak and is not itself reported. day_status returns week_is_full. The assistant may say the week is full and may not quote remaining minutes."}, {"id": "plan_v1_build_order", "label": "Seven-step Build Order", "file_type": "concept", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Riskiest infrastructure first, the free interaction path before the expensive one, and the planning ritual last once everything under it is proven. Each step leaves a check that can fail."}, {"id": "plan_v1_simplicity_pass", "label": "Simplicity Pass", "file_type": "rationale", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying guidelines section 2 to the draft. checkin_hour, a source CHECK for unbuilt capabilities, and week_summary() are speculative. auth_id plus RLS and meta jsonb are kept because they avoid a later migration and speculative columns."}, {"id": "plan_v1_phase_1b_sketch", "label": "Phase 1b Poll Sketch", "file_type": "concept", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original sketch: history.list every 15 minutes, a separate Claude call with its own context on claude-opus-5, and findings written as ordinary tasks with source gmail. Later plans replaced the cursor and the model call with a fixed window and regex."}, {"id": "plan_v1_idempotency", "label": "Webhook Idempotency", "file_type": "concept", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insert messages with channel_msg_id first. A unique violation is a retry: return 200 and stop. Never 500 a webhook or Telegram will duplicate the work."}, {"id": "test_flow_suite", "label": "test_flow.py", "file_type": "concept", "source_file": "PLAN-V1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-step assertions for rollover, natural-language capture, the fast path, the nag, the slip challenge, and the check-in. Also the production invariants run over real audit rows."}], "edges": [{"source": "plan_v1", "target": "architecture_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN-V1.md", "source_location": null, "weight": 1.0}, {"source": "plan_v1", "target": "claude_skills_karpathy_guideline