{"nodes": [{"id": "evaluation_plan", "label": "Evaluation Plan", "file_type": "document", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Why every audit field exists, and the loop that turns a bad reply into a failing test. You cannot evaluate what you cannot replay."}, {"id": "core_audit_begin", "label": "audit begin", "file_type": "code", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens a trace after the user is known so a crash still leaves a row."}, {"id": "core_audit_finish", "label": "audit finish", "file_type": "code", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closes the trace on both the success and failure arms of the webhook and the cron tick."}, {"id": "core_audit_scrub", "label": "audit scrub", "file_type": "code", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redacts secrets at write time. Gmail poll steps pass through it like any other turn."}, {"id": "core_registry_traced", "label": "Traced Tool Wrapper", "file_type": "code", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps BetaFunctionTool.call once so every tool is traced and no capability knows the audit log exists."}, {"id": "migrations_002_audit_log_schema", "label": "002_audit_log.sql", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One audit row per turn, written from a finally block, with a GIN index on steps."}, {"id": "evaluation_plan_expenses_table", "label": "expenses Table", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per spend. Confirmed spends require a category. source is email, chat, or voice. source_ref is unique when present so one email cannot write two rows."}, {"id": "evaluation_plan_audit_log", "label": "audit_log", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per turn, written in a finally block. messages.meta is not enough because a turn that throws never reaches the assistant save, and those crashes are the turns most in need of an audit."}, {"id": "evaluation_plan_steps", "label": "Audit steps", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered events: model, tool, write, decision, card. Tool arguments are the highest-value field because most failures are wrong arguments that look like a correct reply. The decision event records minutes the user is never shown."}, {"id": "evaluation_plan_trust_boundary", "label": "Log Trust Boundary", "file_type": "rationale", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never store email bodies, full card numbers, OTPs, API keys, or raw voice. Redact once at write time. Delete unlabelled audit rows after 60 days and keep labelled rows forever because those are the eval cases. Traces are a second copy of mail sitting behind service_role with no RLS."}, {"id": "evaluation_plan_failure_fix_loop", "label": "Failure to Fix Loop", "file_type": "rationale", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark verdict bad the same day, read steps rather than the reply, freeze an invariant in evals/cases.jsonl, fix the code or prompt the trace implicates, rerun the whole file, and promote a twice-failing case into test_flow.py. Assert invariants, never exact reply strings."}, {"id": "evaluation_plan_verdict", "label": "verdict", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand label in the Supabase editor. The only ground truth. The triage query is verdict equals bad. If labelling takes more than ten seconds the loop dies."}, {"id": "evaluation_plan_amount", "label": "amount", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "What the card was charged. Reconciles against the statement. Not expenditure, because subtracting a shrinking owed balance would make the same dinner cost more after friends repay."}, {"id": "evaluation_plan_share_amount", "label": "share_amount", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "amount divided by headcount. The user's cost. Immutable when someone repays, which is why settlement must not recompute it."}, {"id": "evaluation_plan_owed_amount", "label": "owed_amount", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outstanding to the user. Decrements as people repay and can reach zero. Independent of monthly expenditure."}, {"id": "evaluation_plan_llm_judge", "label": "LLM Judge for the Briefing", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the 11am briefing has no equality invariant. A judge everywhere else would add cost and nondeterminism. Add it after about twenty labelled briefings, not before."}, {"id": "evaluation_plan_cases_jsonl", "label": "evals/cases.jsonl", "file_type": "concept", "source_file": "evaluation_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen inputs and invariant expectations. The runner is a short loop calling handle_turn against a throwaway user. The trace table is the result store; there is no eval platform."}], "edges": [{"source": "evaluation_plan", "target": "plan_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation_plan.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_plan", "target": "architecture_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation_plan.md", "source_location": null, "weight": 1.0}, {"source": "plan_expenses_categories", "target": "evaluation_plan_expenses_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation_plan.md", "source_location": null, "weight": 1.0}, {"source": "plan_expenses_kind", "target": "evaluation_plan_expenses_table", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "evaluation_plan.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_plan_expenses_table", "target": "migrations_003_expenses_schema", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "evaluation_plan.md", "source_location": null, "weight": 1.0}, {"source": "evaluation_plan", "target": "evaluation_plan_audit_log", "relation": "conceptually_r